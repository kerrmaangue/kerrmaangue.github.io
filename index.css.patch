--- index.css	2026-10-21 18:41:53.985265296 +0000
+++ ../kerrmaangue.github.io-main/css/index.css	2026-10-21 18:43:20.300151874 +0000
@@ -290,3 +290,31 @@
 .site-footer{ align-items: center; }
 .footer-contact{ display: flex; flex-wrap: wrap; gap: 6px 18px; font-style: normal; }
 .footer-contact a{ text-decoration: underline; }
+
+
+/* ===== v32: contact dialog, warm default theme, light-mode contrast for the amber theme ===== */
+.contact-dialog{ width: min(560px, calc(100% - 24px)); max-height: calc(100dvh - 24px); margin: auto; padding: 0; border: 2px solid var(--color-primary); border-radius: 14px; background: #0F1520; color: #F8FAFC; box-shadow: 0 24px 60px rgba(0,0,0,.55); overflow: hidden; }
+.contact-dialog::backdrop{ background: rgba(5,8,13,.72); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
+html:not(.tw-dark) .contact-dialog{ background: #fff; color: #0f172a; }
+.contact-panel{ position: relative; max-height: calc(100dvh - 28px); overflow-y: auto; padding: 28px 24px 24px; }
+.contact-close{ position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; font-size: 1.1rem; }
+.contact-close:hover{ background: color-mix(in srgb, var(--color-primary) 18%, transparent); }
+.contact-title{ padding-right: 40px; font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
+.contact-role{ margin-top: 2px; font-weight: 600; color: var(--kicker); }
+.contact-intro{ margin-top: 12px; line-height: 1.6; color: var(--muted); }
+.contact-form{ display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
+.field{ display: flex; flex-direction: column; gap: 6px; font-size: .9rem; font-weight: 500; }
+.field .opt{ font-weight: 400; opacity: .7; }
+.contact-form .input{ width: 100%; font-size: 1rem; font-weight: 400; }
+.contact-form textarea.input{ min-height: 96px; }
+.contact-form .submit-btn{ width: 100%; }
+.hp{ position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
+.form-status{ min-height: 1.4em; font-size: .9rem; }
+.form-status.ok{ color: #4ade80; }
+.form-status.err{ color: #f87171; }
+html:not(.tw-dark) .form-status.ok{ color: #15803d; }
+html:not(.tw-dark) .form-status.err{ color: #b91c1c; }
+html:not(.tw-dark)[data-theme='warning']{ --kicker: #946200; }
+html:not(.tw-dark)[data-theme='warning'] .tw-text-primary,
+html:not(.tw-dark)[data-theme='warning'] .skill-item i{ color: #946200; }
+html:not(.tw-dark)[data-theme='warning'] :focus-visible{ outline-color: #946200; }
