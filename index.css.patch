--- index.css	2026-10-27 19:28:01.300686644 +0000
+++ ../kerrmaangue.github.io-main/css/index.css	2026-10-27 19:29:05.011155472 +0000
@@ -518,3 +518,47 @@
 .exp-meta{ display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
 .exp-date{ margin: 0; padding: .2rem .7rem; border: 1px solid var(--line); border-radius: 999px; font-size: .8rem; font-weight: 500; white-space: nowrap; opacity: 1; }
 .exp-now{ padding: .2rem .65rem; border-radius: 999px; background: var(--color-primary); color: var(--color-btn-text); font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
+
+/* ===== v35: border cleanup. Accent outlines out, depth kept (shadows, fills, warm gradients, hover lift, accent text/buttons/indicators) ===== */
+:root{ --edge: rgba(255,255,255,.07); --line: rgba(128,128,128,.18); }
+html:not(.tw-dark){ --edge: rgba(15,23,42,.08); }
+
+/* profile photo: no ring, soft shadow and a faint warm glow instead */
+.avatar{ box-shadow: 0 14px 34px -10px rgba(0,0,0,.5), 0 0 46px -14px color-mix(in srgb, var(--color-primary) 45%, transparent); }
+html:not(.tw-dark) .avatar{ box-shadow: 0 14px 34px -12px rgba(15,23,42,.35), 0 0 46px -16px color-mix(in srgb, var(--color-primary) 40%, transparent); }
+
+/* cards: hairline edge + warm top tint + shadow */
+.skill-item, .svc-card, .project-card, .resume-card, .exp-card{
+  border: 1px solid var(--edge);
+  background: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 7%, transparent), transparent 55%), var(--card-bg);
+  transition: transform .25s, box-shadow .25s;
+}
+html:not(.tw-dark) .skill-item, html:not(.tw-dark) .svc-card, html:not(.tw-dark) .project-card,
+html:not(.tw-dark) .resume-card, html:not(.tw-dark) .exp-card{
+  background: linear-gradient(160deg, color-mix(in srgb, var(--color-primary) 6%, transparent), transparent 55%), var(--card-bg);
+}
+@media (hover: hover){
+  .skill-item:hover, .resume-card:hover, .exp-card:hover{ transform: translateY(-3px); box-shadow: 0 18px 40px -16px rgba(0,0,0,.45); }
+}
+
+/* dialogs: no accent outline; depth from shadow and a warm wash at the top */
+.contact-dialog{ border: 1px solid var(--edge); box-shadow: 0 30px 80px -20px rgba(0,0,0,.65); }
+html:not(.tw-dark) .contact-dialog, html.tw-dark .contact-dialog{ background-image: linear-gradient(180deg, color-mix(in srgb, var(--color-primary) 9%, transparent), transparent 9rem); }
+
+/* tab bar: soft fill instead of a yellow outline (active tab keeps its accent fill) */
+.pane > header [role="tablist"]{ border: 0; background: color-mix(in srgb, var(--ink) 7%, transparent); box-shadow: 0 8px 20px -12px rgba(0,0,0,.45); }
+
+/* chips and badges: tinted fills instead of outlines */
+.svc-badge, .pill{ border: 0; background: color-mix(in srgb, var(--color-primary) 16%, transparent); color: var(--kicker); }
+.pill{ color: inherit; padding: .2rem .7rem; }
+.exp-date{ border: 0; background: color-mix(in srgb, var(--ink) 9%, transparent); }
+
+/* resume viewer and timeline connector */
+.resume-frame{ border: 0; box-shadow: 0 10px 28px -14px rgba(0,0,0,.5); }
+.exp-list{ border-left-color: color-mix(in srgb, var(--color-primary) 45%, transparent); }
+
+/* experience cards: summary, two columns, tools */
+.exp-summary{ margin: 0 0 1.1rem; line-height: 1.6; color: var(--muted); }
+.exp-cols{ display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1.1rem 2rem; }
+.exp-tools{ margin-top: 1.25rem; }
+.exp-tools .pills{ gap: .5rem; }
