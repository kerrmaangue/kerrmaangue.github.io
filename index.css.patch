--- index.css	2026-10-21 19:01:49.317250521 +0000
+++ ../kerrmaangue.github.io-main/css/index.css	2026-10-23 12:57:50.535413455 +0000
@@ -318,3 +318,94 @@
 html:not(.tw-dark)[data-theme='warning'] .tw-text-primary,
 html:not(.tw-dark)[data-theme='warning'] .skill-item i{ color: #946200; }
 html:not(.tw-dark)[data-theme='warning'] :focus-visible{ outline-color: #946200; }
+
+/* ===== v33: Services tab, experience + resume, fluid layout from 320px to 4K ===== */
+.sr-only{ position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+body{ overflow-x: clip; }
+
+/* scale everything rem-based on very large screens (1920px = 16px, 2560px = 19.2px, 3840px = 25.6px) */
+@media (min-width: 1920px){ html{ font-size: clamp(16px, 0.5vw + 6.4px, 30px); } }
+
+/* sidebar + avatar scale with the screen (450px / 250px at 1440px, as before) */
+.sidebar{ container-type: inline-size; }
+@media (min-width: 1024px){ .sidebar{ width: clamp(17.5rem, 31.25vw, 28.125rem); flex: none; } }
+.avatar{ --av: 14rem; width: var(--av); height: var(--av); }
+@supports (width: 1cqw){ .avatar{ --av: clamp(9.5rem, 55.5cqw, 15.625rem); } }
+
+/* header: a real flex row on desktop so the tabs never run under the theme picker */
+@media (min-width: 768px){ .pane > header [role="tablist"]{ max-width: 100%; scrollbar-width: thin; } }
+@media (min-width: 1024px){
+  .pane > header{ height: 5rem; align-items: center; gap: .75rem; }
+  .pane > header [role="tablist"]{ position: static; left: auto; top: auto; transform: none; height: 3.75rem; flex: 0 1 auto; min-width: 0; margin-inline: auto; }
+  .tab-btn{ padding: .5rem .8rem; }
+}
+@media (min-width: 1024px) and (max-width: 1279px){ .tab-btn{ padding: .5rem .6rem; font-size: .95rem; } }
+
+/* fluid type and containers */
+.hero-h{ font-size: clamp(2.1rem, 1.1rem + 3.4vw, 3.75rem); }
+.skills-wrap, .projects-wrap, .svc-wrap, .exp-wrap{ padding-inline: clamp(.75rem, 4vw, 1.5rem); }
+.skills-wrap{ max-width: 62.5rem; }
+.projects-wrap, .svc-wrap{ max-width: 70rem; }
+.skills-grid{ grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr)); }
+.projects-grid{ grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.75rem), 1fr)); }
+.project-card img{ aspect-ratio: 16 / 9; height: auto; max-height: 16rem; object-fit: cover; }
+[data-tab-name="call"] iframe{ width: 100%; height: clamp(32rem, 82vh, 62rem); }
+.site-footer{ flex-wrap: wrap; gap: .5rem 1.5rem; }
+.footer-contact a, .contact-intro, .exp-points, .svc-list{ overflow-wrap: anywhere; }
+
+/* dialogs */
+.contact-dialog{ width: min(35rem, calc(100% - 1.5rem)); max-height: calc(100vh - 1.5rem); max-height: calc(100dvh - 1.5rem); overscroll-behavior: contain; }
+.svc-dialog{ width: min(42rem, calc(100% - 1.5rem)); }
+.contact-panel{ max-height: calc(100vh - 1.75rem); max-height: calc(100dvh - 1.75rem); padding: clamp(1.1rem, 4vw, 1.75rem); }
+
+/* services */
+.svc-wrap{ width: 100%; margin-inline: auto; padding-top: clamp(1rem, 5%, 3rem); padding-bottom: 2rem; }
+.svc-title{ font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem); font-weight: 600; }
+.svc-sub{ margin-top: .4rem; max-width: 60ch; opacity: .8; }
+.svc-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
+.svc-card{ display: flex; flex-direction: column; gap: .65rem; padding: 1.25rem; border: 2px solid var(--color-primary, #BF5700); border-radius: 12px; background: rgba(255,255,255,.04); box-shadow: 0 10px 30px rgba(0,0,0,.25); }
+html:not(.tw-dark) .svc-card{ background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
+.svc-card i{ font-size: 1.75rem; line-height: 1; color: var(--color-primary, #BF5700); }
+.svc-card h3{ font-size: 1.15rem; font-weight: 600; line-height: 1.3; }
+.svc-card p{ font-size: .95rem; line-height: 1.6; opacity: .85; }
+.svc-actions{ display: flex; flex-wrap: wrap; gap: .6rem; margin-top: auto; padding-top: .6rem; }
+.svc-actions-modal{ margin-top: 1.4rem; }
+.svc-h{ margin-top: 1.1rem; font-size: .95rem; font-weight: 700; }
+.svc-list{ margin: .4rem 0 0; padding-left: 1.15rem; list-style: disc; font-size: .95rem; line-height: 1.6; color: var(--muted); }
+.svc-dialog .contact-intro{ margin-top: .6rem; }
+.svc-dialog .pills{ margin-top: .5rem; }
+
+/* experience + resume */
+.exp-wrap{ width: 100%; max-width: 62rem; margin-inline: auto; padding-top: clamp(1rem, 5%, 3rem); padding-bottom: 2rem; }
+.exp-title{ font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem); font-weight: 600; }
+.exp-sub{ margin-top: .4rem; opacity: .8; }
+.resume-card{ margin-top: 1.25rem; padding: 1.25rem; border: 2px solid var(--color-primary, #BF5700); border-radius: 12px; background: rgba(255,255,255,.04); box-shadow: 0 10px 30px rgba(0,0,0,.25); }
+html:not(.tw-dark) .resume-card{ background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
+.resume-head{ display: flex; align-items: flex-start; gap: .9rem; }
+.resume-head i{ font-size: 2rem; line-height: 1; color: var(--color-primary, #BF5700); }
+.resume-head h3{ font-size: 1.2rem; font-weight: 600; }
+.resume-head p{ margin-top: .2rem; line-height: 1.55; opacity: .85; }
+.resume-actions{ display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1rem; }
+.resume-actions .btn-primary, .resume-actions .btn-ghost{ gap: .5rem; align-items: center; }
+.resume-link{ font-size: .95rem; text-decoration: underline; }
+.resume-preview{ margin-top: 1rem; }
+.resume-frame{ display: block; width: 100%; height: clamp(26rem, 78vh, 64rem); border: 1px solid rgba(128,128,128,.4); border-radius: 8px; background: #fff; }
+.resume-frame p{ padding: 1rem; color: #0f172a; }
+.exp-list{ position: relative; margin: 2rem 0 0; padding: 0 0 0 1.5rem; border-left: 2px solid var(--color-primary, #BF5700); }
+.exp-item{ position: relative; padding-bottom: 2rem; }
+.exp-item:last-child{ padding-bottom: 0; }
+.exp-item::before{ content: ""; position: absolute; left: calc(-1.5rem - 9px); top: .35rem; width: 16px; height: 16px; box-sizing: border-box; border: 3px solid var(--color-primary, #BF5700); border-radius: 999px; background: #0B0F17; }
+html:not(.tw-dark) .exp-item::before{ background: #fff; }
+.exp-role{ font-size: clamp(1.2rem, 1rem + .8vw, 1.65rem); font-weight: 600; line-height: 1.25; }
+.exp-org{ margin-top: .15rem; font-weight: 500; color: var(--kicker); }
+.exp-date{ margin-top: .1rem; font-size: .9rem; opacity: .75; }
+.exp-points{ margin: .6rem 0 0; padding-left: 1.15rem; list-style: disc; line-height: 1.65; color: var(--muted); }
+.exp-points li + li{ margin-top: .35rem; }
+html:not(.tw-dark)[data-theme='warning'] .svc-card i,
+html:not(.tw-dark)[data-theme='warning'] .resume-head i{ color: #946200; }
+/* 320px fixes: newsletter row must shrink instead of bleeding to both edges; keep the tab bar inset on phones */
+.sidebar form{ width: 100%; max-width: 100%; }
+.sidebar form .input{ flex: 1 1 0; min-width: 0; width: auto; }
+.sidebar form .btn-primary{ flex: none; }
+@media (max-width: 767px){ .pane > header [role="tablist"]{ width: calc(100% - 1rem); } }
+.sidebar > .tw-mt-auto{ width: 100%; max-width: 100%; }
